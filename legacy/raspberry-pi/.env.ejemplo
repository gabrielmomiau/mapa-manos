# Copia este archivo como .env y rellena tus datos reales.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).

# ── Modo de cámara ───────────────────────────────────────────────
# Pon 1 para usar la cámara del navegador (despliegue en la nube).
# Pon 0 (o borra la línea) para usar la cámara física del servidor (Raspberry Pi).
MODO_CAMARA_NAVEGADOR=1

# ── Correo saliente (Gmail) ──────────────────────────────────────
# Pasos para obtener la contraseña de aplicación:
#   1. Entra a myaccount.google.com → Seguridad
#   2. Activa "Verificación en dos pasos" si no está activa
#   3. Busca "Contraseñas de aplicaciones" → crea una nueva → copia los 16 caracteres
ENFLUJO_SMTP_HOST=smtp.gmail.com
ENFLUJO_SMTP_PORT=587
ENFLUJO_SMTP_USER=tucorreo@gmail.com
ENFLUJO_SMTP_PASSWORD=abcd efgh ijkl mnop
ENFLUJO_EMAIL_FROM=tucorreo@gmail.com
